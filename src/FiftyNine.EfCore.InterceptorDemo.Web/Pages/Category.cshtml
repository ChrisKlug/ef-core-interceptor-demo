@page "{id:int}"
@model FiftyNine.EfCore.InterceptorDemo.Web.Pages.CategoryModel
@{
    ViewData["Title"] = Model.Category?.Name ?? "Category";
}

<div class="page-heading">
    <h1>@(Model.Category?.Name ?? "Category")</h1>
    <a asp-page="/Index">&larr; Back to categories</a>
</div>

@if (Model.Products.Length == 0)
{
    <p class="empty-state">No products in this category yet.</p>
}
else
{
    <div class="product-grid">
        @foreach (var product in Model.Products)
        {
            <div class="product-card">
                <div class="product-name">@product.Name</div>
                <div class="product-price">@product.Price.ToString("C")</div>
            </div>
        }
    </div>
}
