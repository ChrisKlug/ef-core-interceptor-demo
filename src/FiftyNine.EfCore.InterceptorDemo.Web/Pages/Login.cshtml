@page
@model FiftyNine.EfCore.InterceptorDemo.Web.Pages.LoginModel
@{
    ViewData["Title"] = "Log in";
}

<div class="login-card">
    <h1>Log in</h1>

    @if (Model.ErrorMessage is not null)
    {
        <p class="error-message">@Model.ErrorMessage</p>
    }

    <form method="post">
        <div class="field">
            <label asp-for="Username">Username</label>
            <input asp-for="Username" />
        </div>
        <div class="field">
            <label asp-for="Password">Password</label>
            <input asp-for="Password" type="password" />
        </div>
        <button type="submit">Log in</button>
    </form>

    <p class="hint">Try <strong>kiter</strong>, <strong>winger</strong> or <strong>admin</strong>, password <strong>password123</strong>.</p>
</div>
